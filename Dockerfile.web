# PaisaFlow web — static build served by nginx.
#
#   docker build -f Dockerfile.web -t paisaflow-web .
#   docker run --rm -p 18110:80 paisaflow-web
#
# Stage 1 builds dist/web with Vite (landing at /, app at /app/).
# Stage 2 serves it with nginx:alpine: SPA fallback for /app/*, immutable
# caching for hashed assets, no-cache for HTML, gzip (runtime + pre-compressed
# .gz via gzip_static), and security headers including a CSP that allows the
# sql.js WebAssembly engine and the user's own OpenRouter calls.

FROM node:22-alpine AS build
WORKDIR /src
ENV CI=true
COPY package.json package-lock.json ./
# Native toolchains are not needed for the web bundle; skip lifecycle scripts.
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig.json tsconfig.web.json vite.config.mts ./
COPY src ./src
COPY web ./web
RUN npm run web:build \
  && find dist/web -type f \( -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.svg' -o -name '*.wasm' -o -name '*.json' \) \
       -exec gzip -9 -k {} \;

FROM nginx:1.27-alpine AS serve
COPY docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY docker/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /src/dist/web /usr/share/nginx/html
# Files copied from the host may carry 0600 modes; nginx runs unprivileged.
RUN chmod -R a+rX /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
